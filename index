 ?"<tr><th>Страна</th><th>Доставка</th><th>Пошлина</th><th>RRP</th><th>Макс. LDP USD</th><th>Макс. LDP RUB</th><th>Макс. FOB</th></tr>"
 :"<tr><th>Страна</th><th>Доставка</th><th>Пошлина</th><th>LDP USD</th><th>LDP RUB</th><th>Min RRP</th><th>Выбранный RRP</th><th>IMU</th></tr>"
