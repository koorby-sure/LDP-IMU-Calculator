async function exportReportPdf(){
 const btn=$("downloadReport"),status=$("reportStatus");
 btn.disabled=true;status.textContent="Формируем PDF…";
 let report=null;
 try{
  await loadScriptOnce("https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js","html2canvas-lib");
  await loadScriptOnce("https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js","jspdf-lib");
  report=buildReportElement();
  if(reportImageData){await new Promise(resolve=>setTimeout(resolve,120))}
  const canvas=await window.html2canvas(report,{scale:2,useCORS:true,backgroundColor:"#ffffff",logging:false});
  const {jsPDF}=window.jspdf;
  const pdf=new jsPDF("p","mm","a4");
  const pageW=210,pageH=297,margin=8,imgW=pageW-margin*2,imgH=canvas.height*imgW/canvas.width;
  const data=canvas.toDataURL("image/jpeg",0.93);
  let y=margin,remaining=imgH;
  pdf.addImage(data,"JPEG",margin,y,imgW,imgH);
  remaining-=pageH-margin*2;
  while(remaining>0){
   pdf.addPage();
   y=margin-(imgH-remaining);
   pdf.addImage(data,"JPEG",margin,y,imgW,imgH);
   remaining-=pageH-margin*2
  }
  const stamp=new Date().toISOString().slice(0,10);
  pdf.save(`ldp-rrp-imu-report-${stamp}.pdf`);
  status.textContent="PDF сформирован.";
  setTimeout(()=>{$("reportOverlay").classList.remove("show");status.textContent=""},450)
 }catch(err){
  console.error(err);
  status.textContent="Не удалось сформировать PDF. Проверьте подключение к интернету и повторите."
 }finally{
  if(report)report.remove();
  btn.disabled=false
 }
}
