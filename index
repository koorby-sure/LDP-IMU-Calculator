function buildReportElement(){
 const text=$("reportModelText").value.trim();
 const container=document.createElement("div");
 container.style.cssText="position:fixed;left:-10000px;top:0;width:794px;background:#fff;color:#0f172a;padding:34px;font-family:Arial,sans-serif;font-size:13px;line-height:1.45";
 container.innerHTML=`<style>
  .pdf-title{font-size:24px;font-weight:800;margin:0}.pdf-muted{color:#64748b}.pdf-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:18px 0}.pdf-kpi{border:1px solid #e2e8f0;border-radius:10px;padding:10px}.pdf-kpi b{display:block;margin-top:4px;font-size:15px}.pdf-model{display:flex;gap:16px;align-items:flex-start;margin:16px 0}.pdf-model img{width:170px;max-height:190px;object-fit:contain;border:1px solid #e2e8f0;border-radius:10px}.pdf-note{white-space:pre-wrap;border:1px solid #e2e8f0;border-radius:10px;padding:12px;background:#f8fafc;flex:1;min-height:76px}.pdf-table{width:100%;border-collapse:collapse;margin-top:18px;font-size:11px}.pdf-table th,.pdf-table td{border:1px solid #e2e8f0;padding:7px;text-align:left;vertical-align:top}.pdf-table th{background:#f1f5f9;font-weight:800}.pdf-footer{margin-top:14px;font-size:10px;color:#64748b}
 </style>
 <h1 class="pdf-title">Отчёт LDP / RRP / IMU</h1>
