 <div class="mid"><button class="duty ${state.dutyOn[c]?"":"off"}" data-duty="${c}"><div class="duty-title">Пошлина</div><div style="display:flex;align-items:center;gap:8px"><span class="duty-state">${state.dutyOn[c]?"Вкл.":"Выкл."}</span><span class="switch"></span></div></button>
