    <td>${escapeHtml(country)}</td><td>${escapeHtml(r.route.way)} · ${r.route.days} дн.</td><td>${state.dutyOn[country]?"Вкл.":"Выкл."}</td>
    <td>${r.rrp.toFixed(0)} ₽</td><td>${r.possible?`${usd(r.previousMaxLdp)} - ${usd(r.maxLdp)}`:"—"}</td><td>${r.possible?`${usd(r.minFob)} - ${usd(r.maxFob)}`:"—"}</td>
  </tr>`}).join("")
 }
 return COUNTRIES.map(country=>{const r=calc(country);return `<tr>
    <td>${escapeHtml(country)}</td><td>${escapeHtml(r.route.way)} · ${r.route.days} дн.</td><td>${state.dutyOn[country]?"Вкл.":"Выкл."}</td>
    <td>${usd(r.ldp)}</td><td>${rub(r.ldpRub)}</td><td>${r.rec?r.rec+" ₽":"—"}</td><td>${r.selected} ₽</td><td>${pct(r.imu)}</td>
